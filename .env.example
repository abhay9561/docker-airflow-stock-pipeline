# ---------------------------------------------------------------------------
# Copy this file to .env before starting the pipeline:  cp .env.example .env
# Docker Compose loads .env automatically. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Stock market API (https://www.alphavantage.co/support/#api-key) -------
ALPHAVANTAGE_API_KEY=demo
ALPHAVANTAGE_BASE_URL=https://www.alphavantage.co/query

# Symbols to load on every DAG run (comma separated).
STOCK_SYMBOLS=IBM,AAPL,MSFT

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database holding the stock_prices table (created by sql/init.sql).
POSTGRES_DB=stocks

# Database holding the Airflow metadata (created by sql/init.sql).
AIRFLOW_DB=airflow

# Connection details used by the pipeline script inside the containers.
PG_HOST=postgres
PG_PORT=5432

# --- Airflow UI login ------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
